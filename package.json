{
  "name": "swat-dataset-selector",
  "displayName": "SWAT+ Dataset Selector",
  "description": "Browse and select SWAT+ dataset folders for debugging",
  "version": "0.1.0",
  "publisher": "taciugraskan",
  "repository": {
    "type": "git",
    "url": "https://github.com/tugraskan/swatplus-dataselector"
  },
  "icon": "resources/splus-icon-light-128.png",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "ms-toolsai.jupyter"
  ],
  "activationEvents": [
    "workspaceContains:**/file.cio",
    "onView:swatDatasetView"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "swatplus-mcp": "./dist/mcp-server.js"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "swatplus.chat",
        "name": "swat",
        "fullName": "SWAT+ Dataset",
        "description": "Ask about your indexed SWAT+ dataset — describe HRUs, find references, search rows, look up column docs",
        "isSticky": true
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swat-dataset-selector",
          "title": "SWAT+ Dataset",
          "icon": "resources/splus-activitybar-cutout.svg"
        }
      ]
    },
    "views": {
      "swat-dataset-selector": [
        {
          "id": "swatDatasetView",
          "name": "Dataset Selector",
          "type": "webview",
          "icon": "resources/splus-activitybar-cutout.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "swat-dataset-selector.selectDataset",
        "title": "SWAT+: Select Dataset Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "swat-dataset-selector.selectAndDebug",
        "title": "SWAT+: Select Dataset and Debug",
        "icon": "$(debug-start)"
      },
      {
        "command": "swat-dataset-selector.launchDebug",
        "title": "SWAT+: Debug with Selected Dataset",
        "icon": "$(debug-alt)"
      },
      {
        "command": "swat-dataset-selector.buildIndex",
        "title": "SWAT+: Build Inputs Index",
        "icon": "$(database)"
      },
      {
        "command": "swat-dataset-selector.rebuildIndex",
        "title": "SWAT+: Rebuild Inputs Index",
        "icon": "$(refresh)"
      },
      {
        "command": "swat-dataset-selector.loadIndex",
        "title": "SWAT+: Load Cached Index",
        "icon": "$(database)"
      },
      {
        "command": "swat-dataset-selector.showFKReferences",
        "title": "SWAT+: Show FK References",
        "icon": "$(references)"
      },
      {
        "command": "swat-dataset-selector.showTableViewer",
        "title": "SWAT+: View Tables",
        "icon": "$(table)"
      },
      {
        "command": "swat-dataset-selector.exportIndex",
        "title": "SWAT+: Export Index to JSON",
        "icon": "$(cloud-download)"
      },
      {
        "command": "swat-dataset-selector.revealWorkdataFolder",
        "title": "SWAT+: Reveal Dataset Folder in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "swat-dataset-selector.switchDataset",
        "title": "SWAT+: Switch Dataset",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "swat-dataset-selector.useAsDataset",
        "title": "Use as SWAT+ Dataset",
        "icon": "$(folder-opened)"
      },
      {
        "command": "swat-dataset-selector.editSchema",
        "title": "SWAT+: Edit / Create Schema",
        "icon": "$(edit)"
      },
      {
        "command": "swat-dataset-selector.showDependencyGraph",
        "title": "SWAT+: Show Dependency Graph",
        "icon": "$(graph)"
      },
      {
        "command": "swat-dataset-selector.runDataQualityPreflight",
        "title": "SWAT+: Run Data Quality Preflight",
        "icon": "$(checklist)"
      },
      {
        "command": "swat-dataset-selector.processHruSubset",
        "title": "SWAT+: Create HRU Subset",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "swat-dataset-selector.processHruSubsetAndRun",
        "title": "SWAT+: Create HRU Subset and Run",
        "icon": "$(run)"
      },
      {
        "command": "swat-dataset-selector.checkInputFiles",
        "title": "SWAT+: Check Input Files",
        "icon": "$(search)"
      },
      {
        "command": "swat-dataset-selector.generateOutputNotebooks",
        "title": "SWAT+: Generate Output Notebooks",
        "icon": "$(notebook)"
      },
      {
        "command": "swat-dataset-selector.openOutputAsDataFrame",
        "title": "SWAT+: Explore Output File",
        "icon": "$(table)"
      },
      {
        "command": "swat-dataset-selector.describeEntity",
        "title": "SWAT+: Describe Entity",
        "icon": "$(info)"
      },
      {
        "command": "swat-dataset-selector.searchDataset",
        "title": "SWAT+: Search Dataset",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "swat-dataset-selector.launchDebug",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.buildIndex",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.rebuildIndex",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.loadIndex",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.exportIndex",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.showFKReferences",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.showTableViewer",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.showDependencyGraph",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.runDataQualityPreflight",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.checkInputFiles",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.describeEntity",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.searchDataset",
          "when": "swatplus.hasIndex"
        },
        {
          "command": "swat-dataset-selector.processHruSubset",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.processHruSubsetAndRun",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.generateOutputNotebooks",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.revealWorkdataFolder",
          "when": "swatplus.hasDataset"
        },
        {
          "command": "swat-dataset-selector.useAsDataset",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "swat-dataset-selector.buildIndex",
          "when": "view == swatDatasetView && swatplus.hasDataset",
          "group": "navigation@1"
        },
        {
          "command": "swat-dataset-selector.showTableViewer",
          "when": "view == swatDatasetView && swatplus.hasIndex",
          "group": "navigation@2"
        },
        {
          "command": "swat-dataset-selector.switchDataset",
          "when": "view == swatDatasetView",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "swat-dataset-selector.openOutputAsDataFrame",
          "when": "explorerResourceIsFile && (resourceExtname == .csv || resourceExtname == .out || resourceExtname == .txt)",
          "group": "navigation@99"
        },
        {
          "command": "swat-dataset-selector.useAsDataset",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@100"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "swatplusGettingStarted",
        "title": "Get started with SWAT+",
        "description": "Select a dataset, index it, and navigate your SWAT+ model like source code.",
        "steps": [
          {
            "id": "selectDataset",
            "title": "Select a dataset",
            "description": "Choose the folder holding your SWAT+ inputs — the one containing file.cio.\n[Select Dataset Folder](command:swat-dataset-selector.selectDataset)",
            "media": {
              "markdown": "resources/walkthrough/select-dataset.md"
            },
            "completionEvents": [
              "onCommand:swat-dataset-selector.selectDataset",
              "onCommand:swat-dataset-selector.useAsDataset"
            ]
          },
          {
            "id": "buildIndex",
            "title": "Build the inputs index",
            "description": "Index the dataset so foreign keys, hovers, and validation work. Requires Python with pandas.\n[Build Inputs Index](command:swat-dataset-selector.buildIndex)",
            "media": {
              "markdown": "resources/walkthrough/build-index.md"
            },
            "completionEvents": [
              "onCommand:swat-dataset-selector.buildIndex"
            ]
          },
          {
            "id": "navigate",
            "title": "Navigate the model",
            "description": "Ctrl+Click foreign keys to jump between files, hover for column documentation, and view the dependency graph.\n[View Tables](command:swat-dataset-selector.showTableViewer)",
            "media": {
              "markdown": "resources/walkthrough/navigate.md"
            },
            "completionEvents": [
              "onCommand:swat-dataset-selector.showTableViewer",
              "onCommand:swat-dataset-selector.showDependencyGraph",
              "onCommand:swat-dataset-selector.showFKReferences"
            ]
          },
          {
            "id": "exploreOutputs",
            "title": "Explore results",
            "description": "Open output files as DataFrames, generate notebooks, or carve out an HRU subset to iterate faster.\n[Generate Output Notebooks](command:swat-dataset-selector.generateOutputNotebooks)",
            "media": {
              "markdown": "resources/walkthrough/explore-outputs.md"
            },
            "completionEvents": [
              "onCommand:swat-dataset-selector.generateOutputNotebooks",
              "onCommand:swat-dataset-selector.openOutputAsDataFrame"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "SWAT+ Dataset Selector",
      "properties": {
        "swatplus.schemaDirectories": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional directories to scan for SWAT+ schema JSON files. Supports ${workspaceFolder}."
        },
        "swatplus.datasetDirectory": {
          "type": "string",
          "default": "workdata",
          "description": "Directory (relative to the workspace root, or absolute) that contains SWAT+ dataset folders. It is shown in the Dataset Folder section beneath Recent Datasets. Defaults to 'workdata'."
        },
        "swatplus.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log SWAT+ Dataset Selector activity to the developer console. Useful when diagnosing sidebar or navigation issues; off by default so the console stays quiet during normal use."
        },
        "swatplus.openTablesAfterIndex": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Show a notification offering to open the table viewers.",
            "Open the table viewer and file.cio automatically, as before.",
            "Do not open any panels after indexing."
          ],
          "default": "prompt",
          "description": "What to do with the table viewers after building or rebuilding the inputs index. 'always' reproduces the previous behaviour of taking over the editor area on every build."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run check-webview && node esbuild.js",
    "check-webview": "node scripts/check_webview_scripts.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run check-webview && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha",
    "test:python": "python3 -m unittest scripts.test_merge_overlays scripts.test_merge_output_families",
    "package:vsix": "npm run package && vsce package",
    "publish:pre-release": "npm run package && vsce publish --pre-release"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
