{
  "name": "swat-hru-subset",
  "displayName": "SWAT+ HRU Subset",
  "description": "Carve a SWAT+ dataset down to the HRUs you pick, in a new folder next to it. Pick HRUs from a table, preview the feeder HRUs, keep the downstream routing.",
  "version": "0.2.0",
  "publisher": "PbsandtDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tugraskan/swatplus-dataselector",
    "directory": "hru-subset"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "SWAT+",
    "SWATPlus",
    "hydrology",
    "HRU"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "swatHruSubset.createSubset",
        "title": "Create Subset…",
        "category": "SWAT+ HRU Subset",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "swatHruSubset.createSubsetFromFolder",
        "title": "Create HRU Subset from This Folder…",
        "icon": "$(split-horizontal)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swat-hru-subset",
          "title": "SWAT+ HRU Subset",
          "icon": "resources/subset-activitybar.svg"
        }
      ]
    },
    "views": {
      "swat-hru-subset": [
        {
          "id": "swatHruSubsetView",
          "name": "HRU Subset",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "swatHruSubset.createSubsetFromFolder",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "swatHruSubset.createSubsetFromFolder",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@100"
        }
      ]
    },
    "configuration": {
      "title": "SWAT+ HRU Subset",
      "properties": {
        "swatHruSubset.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Python interpreter used to run the subset script. Empty: the environment variable `SWATPLUS_PYTHON`, then `py`, `python`, `python3` on Windows (`python3`, `python` elsewhere). The first one that answers `--version` is used; the Microsoft Store `python3` stub is skipped. The script runs with that one interpreter only."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "lint": "eslint src",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "test": "npm run compile-tests && mocha",
    "check:real": "npm run compile-tests && node scripts/real-check.js",
    "vscode:prepublish": "npm run package",
    "package:vsix": "vsce package",
    "test:python": "python3 -m unittest discover -s python -p \"test_*.py\"",
    "smoke:vscode": "npm run compile && node scripts/smoke-vscode.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
